# All EXPO_PUBLIC values are bundled into the app. Never put secrets here.
EXPO_PUBLIC_DATA_MODE=mock
EXPO_PUBLIC_DEMO_SCENARIO=normal
# Demo scenarios: normal, empty, load-error, submit-error, insights-ready
# Proposed API adapter: requires agreed backend contract and runtime validation.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
# Approved direct HTTPS video URL (MP4 or supported stream); not a webpage URL.
EXPO_PUBLIC_STUDY_VIDEO_URL=
